* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background: linear-gradient(135deg, #ffe5ec 0%, #ffc2d1 100%);
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  margin: 0;
  padding: 20px;
}

.container {
  width: 100%;
  max-width: 400px;
}

.card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 28px 24px;
  border-radius: 24px;
  box-shadow: 0 15px 35px rgba(255, 77, 109, 0.2);
  text-align: center;
}

h2, h1 {
  color: #ff4d6d;
  margin-top: 0;
}

.tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
  background: #fff0f3;
  padding: 4px;
  border-radius: 14px;
}

.tabs button {
  flex: 1;
  background: transparent;
  color: #ff4d6d;
  border: none;
  padding: 10px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.tabs button.active {
  background: #ff4d6d;
  color: white;
  box-shadow: 0 4px 12px rgba(255, 77, 109, 0.3);
}

input {
  width: 100%;
  padding: 14px;
  margin: 8px 0;
  border: 1.5px solid #ffccd5;
  border-radius: 14px;
  font-size: 16px;
  outline: none;
  background: #fff;
}

input:focus {
  border-color: #ff4d6d;
}

button#auth-btn {
  width: 100%;
  padding: 14px;
  margin-top: 14px;
  background-color: #ff4d6d;
  color: white;
  border: none;
  border-radius: 14px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 4px 15px rgba(255, 77, 109, 0.4);
}

.secondary-btn {
  background: none;
  border: none;
  color: #888;
  font-size: 13px;
  margin-top: 14px;
  cursor: pointer;
  text-decoration: underline;
}

.code-box {
  margin-top: 18px;
  background: #fff0f3;
  padding: 14px;
  border-radius: 16px;
  border: 2px dashed #ff4d6d;
}

.code-box h3 {
  margin: 6px 0 0 0;
  color: #c9184a;
  letter-spacing: 3px;
  font-size: 28px;
}

.hidden {
  display: none !important;
}

.error {
  color: #d90429;
  font-size: 13px;
  margin-top: 10px;
}
